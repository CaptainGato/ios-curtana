+		    (unsigned)spi_mode - 1u : 0u;
+		st.gpio = ml_io_map(TOUCH_SPI_TLMM_PA, 0x10000);
+		if (!st.gpio) {
+			printf("SWEET TOUCH: TLMM mapping failed\n");
+			goto out;
+		}
+		printf("SWEET TOUCH: SPI bit-bang order %u (pins %u/%u/%u/%u)\n",
+		    order, touch_spi_order[order][0], touch_spi_order[order][1],
+		    touch_spi_order[order][2], touch_spi_order[order][3]);
+		touch_spi_pins(order);
+		int probe = touch_fts_spi_start();
+		if (probe) {
+			printf("SWEET TOUCH: no SPI IC on this pin order; stopping\n");
+			goto out;
+		}
+		st.kind = TOUCH_FTS_SPI;
+		printf("SWEET TOUCH: selected FocalTech FTS over SPI, 1080x2400\n");
+		unsigned spi_errors = 0, spi_ticks = 0;
+		while (!st.dead) {
+			/* IRQ is active low; also read every 100 ms without it. */
+			if (!spi_level(TOUCH_SPI_IRQ) || st.active ||
+			    (++spi_ticks % 10u) == 0) {
+				int err = touch_fts_spi_report();
+				if (err) {
+					if ((spi_errors++ % 100u) == 0) {
+						printf("SWEET TOUCH: spi report err=%d\n", err);
+					}
+					if (spi_errors == 10) {
+						touch_report(0, st.x, st.y);
+					}
+				} else {
+					spi_errors = 0;
+				}
+			}
+			touch_wait(10);
+		}
+		touch_report(0, st.x, st.y);
+		goto out;
+	}
+
