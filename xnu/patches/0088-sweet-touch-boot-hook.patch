--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -1429,8 +1429,24 @@
 	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
 	if (kr == KERN_SUCCESS) {
 		thread_deallocate(thread);
 	} else {
 		printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
 	}
 }
+
+/*
+ * Diagnostic hook: start the touch thread even when the root comes from a
+ * RAM disk (rd=md0), so the touch bus can be probed without a UFS root.
+ * Enabled with sweettouchboot=1; inert on normal boots.
+ */
+void
+sweet_touch_boot_probe(void)
+{
+	uint32_t on = 0;
+
+	(void)PE_parse_boot_argn("sweettouchboot", &on, sizeof(on));
+	if (on) {
+		sweet_touch_init();
+	}
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
diff --git a/bsd/kern/bsd_init.c b/bsd/kern/bsd_init.c
--- a/bsd/kern/bsd_init.c
+++ b/bsd/kern/bsd_init.c
@@ -798,6 +798,11 @@
 	bsd_init_kprintf("calling bsd_autoconf\n");
 	bsd_autoconf();
 
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+	extern void sweet_touch_boot_probe(void);
+	sweet_touch_boot_probe();
+#endif
+
 #if CONFIG_DTRACE
 	dtrace_postinit();
 #endif
