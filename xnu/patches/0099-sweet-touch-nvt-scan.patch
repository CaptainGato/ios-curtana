 	}
 }
 
-static void
-touch_nvt_probe(void)
+/* The IC answers only through one pin order (shim probe v10: MOSI=54,
+ * MISO=53, CLK=55, CS=56, VDDIO 1.8 V from ldoa18). Sweep all four
+ * orders and lock the one whose id reads 75 66 03 (NT36675). */
+static int
+touch_nvt_probe_once(const char *tag)
 {
-	printf("SWEET TOUCH: NVT probe, software reset only (GPIO 8 untouched)\n");
-	{
-		int rc = sweet_rpmh_vreg_enable("ldoa18", 1800);
-		printf("SWEET TOUCH: NVT l18 enable rc=%d\n", rc);
-		touch_wait(100);
-	}
-	for (unsigned i = 0; i < 5; ++i) {
+	uint8_t id[6] = {0};
+
+	for (unsigned i = 0; i < 3; ++i) {
 		touch_nvt_write_addr(NVT_SWRST_N8, 0x69);
 		touch_wait(5);
-		touch_nvt_write_addr(NVT_RD_FAST, 0x00);
-		touch_nvt_print_id("reset", i);
-		touch_wait(10);
 	}
-	/* repeat every 3 s for 3 min so the line can be caught on the panel */
-	for (unsigned n = 0; n < 60; ++n) {
-		touch_wait(3000);
-		touch_nvt_print_id("poll", n);
+	touch_nvt_write_addr(NVT_RD_FAST, 0x00);
+	touch_nvt_page(NVT_ID_PAGE);
+	touch_wait(250);
+	touch_nvt_read(NVT_ID_REG, id, 6);
+	touch_nvt_print_id(tag, 0);
+	return (id[3] == 0x75 && id[4] == 0x66 && id[5] == 0x03);
+}
+
+static unsigned
+touch_nvt_scan(void)
+{
+	for (unsigned o = 0; o < 4; ++o) {
+		printf("SWEET TOUCH: NVT scan order %u (pins %u/%u/%u/%u)\n",
+		    o, touch_spi_order[o][0], touch_spi_order[o][1],
+		    touch_spi_order[o][2], touch_spi_order[o][3]);
+		touch_nvt_pins(o);
+		if (touch_nvt_probe_once("scan")) {
+			printf("SWEET TOUCH: NVT locked order %u\n", o);
+			return o;
+		}
+	}
+	printf("SWEET TOUCH: NVT scan: no IC answer in any order\n");
+	return 4;
+}
+
+static void
+touch_nvt_probe(void)
+{
+	int rc = sweet_rpmh_vreg_enable("ldoa18", 1800);
+
+	printf("SWEET TOUCH: NVT probe: l18 rc=%d, scanning orders 0-3\n", rc);
+	touch_wait(100);
+	unsigned locked = touch_nvt_scan();
+	if (locked < 4u) {
+		touch_nvt_pins(locked);
+		/* keep the 3-min validation poll until the report path lands */
+		for (unsigned n = 0; n < 60; ++n) {
+			touch_wait(3000);
+			touch_nvt_print_id("poll", n);
+		}
 	}
 }
 
