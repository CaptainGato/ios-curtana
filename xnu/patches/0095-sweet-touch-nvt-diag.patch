diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
index 833eee3..e192355 100644
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -928,6 +928,27 @@ touch_nvt_print_id(const char *tag, unsigned n)
 		(id[3] == 0x75 && id[4] == 0x66 && id[5] == 0x03) ? " = NT36675" : "");
 }
 
+static void
+touch_nvt_diag(const char *tag, int pulltest)
+{
+	static const uint8_t pins[6] = { 8, 9, 53, 54, 55, 56 };
+	for (unsigned i = 0; i < 6; ++i) {
+		unsigned p = pins[i];
+		uint32_t cfg = spi_rd(spi_pin_base(p), TOUCH_GPIO_CFG(p));
+		printf("SWEET TOUCH: NVT %s gpio%u cfg=%08x func=%u in=%d\n",
+		    tag, p, cfg, (cfg >> 2) & 0xfu, spi_level(p));
+	}
+	if (pulltest) {
+		spi_in(spi_miso, 1);
+		delay(1000);
+		int lo = spi_level(spi_miso);
+		spi_in(spi_miso, 3);
+		delay(1000);
+		int hi = spi_level(spi_miso);
+		printf("SWEET TOUCH: NVT miso pulldown=%d pullup=%d\n", lo, hi);
+	}
+}
+
 static void
 touch_nvt_probe(void)
 {
@@ -1637,10 +1658,12 @@ touch_thread(void *arg, wait_result_t result)
 		printf("SWEET TOUCH: SPI bit-bang order %u (pins %u/%u/%u/%u)\n",
 		    order, touch_spi_order[order][0], touch_spi_order[order][1],
 		    touch_spi_order[order][2], touch_spi_order[order][3]);
+		touch_nvt_diag("before", 0);
 		int nvt_mode = 0;
 		(void)PE_parse_boot_argn("sweetnvt", &nvt_mode, sizeof(nvt_mode));
 		if (nvt_mode) {
 			touch_nvt_pins(order);
+			touch_nvt_diag("after", 1);
 			touch_nvt_probe();
 			goto out;
 		}
