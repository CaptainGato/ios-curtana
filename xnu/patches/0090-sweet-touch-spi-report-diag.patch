diff --git a/bsd/dev/sweet_touch.c b/bsd/dev/sweet_touch.c
--- a/bsd/dev/sweet_touch.c
+++ b/bsd/dev/sweet_touch.c
@@ -599,8 +599,8 @@
 fts_spi_read(uint8_t reg, uint8_t *out, unsigned len, int *crc_ok,
     uint8_t *status)
 {
-	uint8_t tx[96] = {0}, rx[96];
-	if (len > 80u) {
+	uint8_t tx[128] = {0}, rx[128];
+	if (len > 110u) {
 		return EINVAL;
 	}
 	tx[0] = reg;
@@ -689,12 +689,18 @@
 static int
 touch_fts_spi_report(void)
 {
