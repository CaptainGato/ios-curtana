+		if (dbg++ < 4u) {
+			printf("SWEET TOUCH: report status=%02x\n", st8);
+		}
 		return EIO;
 	}
 	if ((buf[0] & 0xf0u) != 0x90u) {
@@ -1330,7 +1336,7 @@
 		}
 		st.kind = TOUCH_FTS_SPI;
 		printf("SWEET TOUCH: selected FocalTech FTS over SPI, 1080x2400\n");
