+		unsigned spi_errors = 0, spi_ticks = 0, spi_reports = 0;
 		while (!st.dead) {
 			/* IRQ is active low; also read every 100 ms without it. */
 			if (!spi_level(TOUCH_SPI_IRQ) || st.active ||
@@ -1345,6 +1351,10 @@
 					}
 				} else {
 					spi_errors = 0;
+					if (spi_reports++ < 40u) {
+						printf("SWEET TOUCH: x=%d y=%d mask=%x\n",
