+	uint8_t buf[96], st8 = 0;
 	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
 	uint32_t mask = 0, seen = 0;
+	static unsigned dbg;
 
+	/* Vendor reads 91 bytes (touch + gesture); try the touch part first. */
 	memset(buf, 0, sizeof(buf));
