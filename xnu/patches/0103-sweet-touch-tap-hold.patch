@@ -400,6 +400,8 @@ touch_checksum(const uint8_t *buf, unsigned len)
 static void
 touch_report(uint32_t mask, const int *x, const int *y)
 {
+	static unsigned age[TOUCH_MAX];
+	static unsigned held;
 	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
 		uint32_t bit = 1u << id;
