+/*
+ * Minimal polled SWEET keys. Call once after the scheduler is running.
+ * See hw-report.md: volume-up is PM6150L SID 4, NOT PM6150 SID 0.
+ * PMIC access is READ ONLY: the sole MMIO write issues EXT_READL on an
+ * observer channel. No PMIC config, IRQ acknowledge or reset writes exist.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern void sweet_hid_key(int key, int down);
+void sweet_keys_init(void);
+
+#define KEYS_CORE_PA     0x0c440000u
+#define KEYS_OBS_PA      0x0e600000u
+#define KEYS_CNFG_PA     0x0c40a000u
+#define KEYS_PON_RT      0x0810u
+#define KEYS_GPIO_RT     0xc110u
+#define KEYS_NO_APID     0xffffu
+
+static vm_offset_t keys_core, keys_obs, keys_cnfg;
+static uint16_t keys_pon_apid = KEYS_NO_APID, keys_gpio_apid = KEYS_NO_APID;
+static uint32_t keys_version, keys_last_status;
+static bool keys_started;
+static int keys_sleep_chan;
+
+static uint32_t
+keys_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+/* v5 can map one PPID more than once; prefer the apps-owned entry. */
+static uint16_t
+keys_find_apid(uint16_t ppid, uint32_t count)
+{
+	uint16_t found = KEYS_NO_APID;
+	for (uint32_t i = 0; i < count; ++i) {
+		uint32_t map = keys_rd(keys_core, 0x900u + 4u * i);
+		if (map == 0 || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		uint32_t owner = keys_rd(keys_cnfg, 0x700u + 4u * i) & 7u;
+		if (found == KEYS_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+static bool
+keys_read(uint16_t apid, uint16_t addr, uint8_t *out)
+{
+	if (apid == KEYS_NO_APID) {
+		return false;
+	}
+	uint32_t off = 0x80u * apid; /* obs + EE(0)*0x10000 */
+	uint32_t cmd = (1u << 27) | ((uint32_t)(addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(keys_obs + off) = cmd; /* EXT_READL, one byte */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		keys_last_status = keys_rd(keys_obs, off + 0x08u);
+		if (keys_last_status & 1u) {
+			if (keys_last_status & 0x0eu) {
+				return false;
+			}
+			*out = (uint8_t)keys_rd(keys_obs, off + 0x18u);
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+keys_wait(void)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(20, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&keys_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+keys_thread(void *arg, wait_result_t result)
+{
+	int state[3] = {0, 0, 0};
+	unsigned errors = 0;
+	(void)arg;
+	(void)result;
+	for (;;) {
+		uint8_t pon = 0, gpio = 0;
+		bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+		bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+		int now[3] = {!!(pon & 1u), !(gpio & 1u), !!(pon & 2u)};
+		if (!pok || !gok) {
+			if ((errors++ % 250u) == 0) {
+				printf("SWEET KEYS: read error pon-ok=%d gpio-ok=%d arb-status=%#x\n",
+				    pok, gok, keys_last_status);
+			}
+		} else {
+			errors = 0;
+		}
+		for (int k = 0; k < 3; ++k) {
+			if ((k == 1 ? gok : pok) && now[k] != state[k]) {
+				state[k] = now[k];
+				printf("SWEET KEYS: key=%d down=%d pon=%#x gpio4:c110=%#x\n",
+				    k, state[k], pon, gpio);
+				sweet_hid_key(k, state[k]);
+			}
+		}
+		keys_wait();
+	}
+}
+
+void
+sweet_keys_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (keys_started) {
+		return;
+	}
+	keys_started = true;
+	(void)PE_parse_boot_argn("sweetkeys", &enabled, sizeof(enabled));
+	if (!enabled) {
+		printf("SWEET KEYS: disabled (sweetkeys=0)\n");
+		return;
+	}
+	keys_core = ml_io_map(KEYS_CORE_PA, 0x2000);
+	keys_cnfg = ml_io_map(KEYS_CNFG_PA, 0x1000);
+	keys_obs = ml_io_map(KEYS_OBS_PA, 0x10000);
+	if (!keys_core || !keys_cnfg || !keys_obs) {
+		printf("SWEET KEYS: MMIO mapping failed\n");
+		return;
+	}
+	keys_version = keys_rd(keys_core, 0);
+	uint32_t count = keys_rd(keys_core, 4) & 0x7ffu;
+	if (keys_version < 0x50000000u || keys_version >= 0x70000000u ||
+	    count == 0 || count > 512) {
+		printf("SWEET KEYS: unsupported arbiter version=%#x apids=%u\n",
+		    keys_version, count);
+		return;
+	}
+	keys_pon_apid = keys_find_apid(0x008, count);
+	keys_gpio_apid = keys_find_apid(0x4c1, count);
+	uint8_t pon = 0, gpio = 0, mode = 0, en = 0, subtype = 0;
+	bool pok = keys_read(keys_pon_apid, KEYS_PON_RT, &pon);
+	bool gok = keys_read(keys_gpio_apid, KEYS_GPIO_RT, &gpio);
+	bool mok = keys_read(keys_gpio_apid, 0xc140, &mode);
+	bool eok = keys_read(keys_gpio_apid, 0xc146, &en);
+	bool sok = keys_read(keys_gpio_apid, 0xc105, &subtype);
+	printf("SWEET KEYS: arb=%#x apids=%u pon-apid=%u gpio4-apid=%u pon=%#x/%d gpio=%#x/%d mode=%#x/%d en=%#x/%d subtype=%#x/%d\n",
+	    keys_version, count, keys_pon_apid, keys_gpio_apid,
+	    pon, pok, gpio, gok, mode, mok, en, eok, subtype, sok);
+	/* GPIO configuration belongs to firmware. Diagnose, never repair it here. */
+	unsigned dir = subtype >= 0x10u && subtype <= 0x13u ?
+	    mode & 3u : (mode >> 4) & 7u;
+	if (!eok || !mok || !sok || !(en & 0x80u) || (dir != 0 && dir != 2)) {
+		printf("SWEET KEYS: GPIO2 not confirmed enabled as input; volume-up withheld, PMIC unchanged\n");
+		keys_gpio_apid = KEYS_NO_APID;
+	}
+	if (!pok && !gok) {
+		printf("SWEET KEYS: no readable keys; polling retained for recovery\n");
+	}
+	kern_return_t kr = kernel_thread_start(keys_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET KEYS: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
--- /dev/null
+++ b/bsd/dev/sweet_touch.c
@@ -0,0 +1,1036 @@
+/*
+ * SWEET SE7 FIFO I2C / GT9896 Yellowstone / Focaltech 54:52 bring-up.
+ * Call once after the scheduler is running; all work runs on one thread.
+ * Requires ABL-loaded GENI I2C firmware and an already powered L11C rail.
+ * No firmware/config upload, RPMh votes or PMIC writes. Only IC data write:
+ * zero to GT9896's event status after reading a report. See hw-report.md.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <kern/clock.h>
+#include <kern/thread.h>
+#include <kern/sched_prim.h>
+#include <machine/machine_routines.h>
+#include <pexpert/pexpert.h>
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+/* Mach MIG declaration is not included by BSD's exported thread.h. */
+extern kern_return_t thread_terminate(thread_t);
+extern void sweet_hid_touch(int finger, int down, int x, int y);
+void sweet_touch_init(void);
+
+#define TOUCH_SE_PA      0x00a84000u
+#define TOUCH_GCC_PA     0x00100000u
+#define TOUCH_NORTH_PA   0x03900000u /* DT TLMM + NORTH (0x500000) */
+#define TOUCH_GCC_VOTE   0x5200cu
+#define TOUCH_RCG       0x18148u    /* wrapper1 LOCAL S1 = global SE7 */
+#define TOUCH_GPIO_CFG(n) ((uint32_t)(n) * 0x1000u)
+#define TOUCH_GPIO_IO(n)  (TOUCH_GPIO_CFG(n) + 4u)
+#define TOUCH_MAX        10u
+#define TOUCH_GOODIX     1
+#define TOUCH_FTS        2
+#define TOUCH_TCM        3
+
+#define SE_STATUS       0x040u
+#define SE_MCLK         0x048u
+#define SE_FW           0x068u
+#define SE_CLK_SEL      0x07cu
+#define SE_DMA          0x258u
+#define SE_TX_LEN       0x26cu
+#define SE_RX_LEN       0x270u
+#define SE_SCL          0x278u
+#define SE_CMD          0x600u
+#define SE_CTRL         0x604u
+#define SE_IRQ          0x610u
+#define SE_IRQ_EN       0x614u
+#define SE_IRQ_CLR      0x618u
+#define SE_TX           0x700u
+#define SE_RX           0x780u
+#define SE_TX_COUNT     0x800u
+#define SE_RX_COUNT     0x804u
+#define SE_HW_TX        0xe24u
+#define SE_HW_RX        0xe28u
+#define SE_DONE         (1u << 0)
+#define SE_NACK         (1u << 10)
+#define SE_ERRORS       (0x0eu | (1u << 9) | (1u << 10) | (1u << 12) | \
+                         (1u << 13) | (3u << 24) | (3u << 28))
+#define SE_EVENTS       (SE_DONE | SE_ERRORS | (1u << 5) | (1u << 26) | \
+                         (1u << 27) | (1u << 30))
+
+static struct {
+	vm_offset_t se, gcc, gpio;
+	bool started, dead;
+	int kind, irq_hint;
+	uint32_t irq_status, active;
+	int x[TOUCH_MAX], y[TOUCH_MAX];
+} st;
+static int touch_sleep_chan;
+
+static uint32_t
+touch_rd(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+touch_wr(vm_offset_t base, uint32_t off, uint32_t val)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = val;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static void
+touch_wait(unsigned ms)
+{
+	uint64_t deadline;
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&touch_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static bool
+touch_wait_clear(vm_offset_t base, uint32_t off, uint32_t mask)
+{
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (!(touch_rd(base, off) & mask)) {
+			return true;
+		}
+		delay(1);
+	}
+	return false;
+}
+
+static void
+touch_gpio(unsigned pin, unsigned mux, unsigned pull, unsigned drive, bool out)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t cfg = touch_rd(st.gpio, off);
+	if (out) {
+		/* Set the output latch before enabling output, avoiding a reset pulse. */
+		touch_wr(st.gpio, TOUCH_GPIO_IO(pin),
+		    touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) | 2u);
+	}
+	cfg &= ~0x3ffu;
+	cfg |= (mux << 2) | pull | (drive << 6) | (out ? 0x200u : 0u);
+	touch_wr(st.gpio, off, cfg);
+}
+
+/* Drive a GPIO as an output with an explicit latch value. */
+static void
+touch_gpio_out(unsigned pin, bool high, unsigned pull, unsigned drive)
+{
+	uint32_t off = TOUCH_GPIO_CFG(pin);
+	uint32_t io = touch_rd(st.gpio, TOUCH_GPIO_IO(pin)) & ~2u;
+	/* Set the output latch before enabling the output. */
+	touch_wr(st.gpio, TOUCH_GPIO_IO(pin), high ? io | 2u : io);
+	uint32_t cfg = touch_rd(st.gpio, off) & ~0x3ffu;
+	cfg |= pull | (drive << 6) | 0x200u;
+	touch_wr(st.gpio, off, cfg);
+}
+
+static bool
+touch_clocks(void)
+{
+	/*
+	 * Wrapper1/SE7 branch votes: sdmmagpie (SM7150) hosts them in 0x5200c,
+	 * atoll (SM7125) in 0x52008. Vote on both, preserving other users;
+	 * the polled bits are reserved in the register the SoC does not use.
+	 */
+	uint32_t mask = (0x0fu << 18) | (1u << 23);
+	touch_wr(st.gcc, 0x52008u, touch_rd(st.gcc, 0x52008u) | mask);
+	touch_wr(st.gcc, TOUCH_GCC_VOTE, touch_rd(st.gcc, TOUCH_GCC_VOTE) | mask);
+	uint32_t dfs = touch_rd(st.gcc, TOUCH_RCG + 0x14u);
+	uint32_t cfg = touch_rd(st.gcc, TOUCH_RCG + 4u);
+	printf("SWEET TOUCH: gcc votes=%#x/%#x rcg=%#x cfg=%#x dfs=%#x\n",
+	    touch_rd(st.gcc, 0x52008u), touch_rd(st.gcc, TOUCH_GCC_VOTE),
+	    touch_rd(st.gcc, TOUCH_RCG), cfg, dfs);
+	if (dfs & 1u) {
+		/* SE CLK_SEL=0 selects DFS performance level 0. Do not alter tables. */
+		cfg = touch_rd(st.gcc, TOUCH_RCG + 0x1cu);
+		if ((cfg & 0x371fu) != 1u) {
+			printf("SWEET TOUCH: DFS level0=%#x is not XO/1; need clock integration\n", cfg);
+			return false;
+		}
+	} else {
+		/* XO parent 0, HID divider 1 => 19.2 MHz. No PLL or voltage change. */
+		cfg = (cfg & ~(0x371fu | (1u << 20))) | 1u;
+		touch_wr(st.gcc, TOUCH_RCG + 4u, cfg);
+		touch_wr(st.gcc, TOUCH_RCG, touch_rd(st.gcc, TOUCH_RCG) | 1u);
+		if (!touch_wait_clear(st.gcc, TOUCH_RCG, 1u)) {
+			printf("SWEET TOUCH: RCG update timeout\n");
+			return false;
+		}
+	}
+	const uint32_t branches[] = {0x18004, 0x18008, 0x1800c, 0x18010, 0x18144};
+	for (unsigned i = 0; i < sizeof(branches) / sizeof(branches[0]); ++i) {
+		if (!touch_wait_clear(st.gcc, branches[i], 1u << 31)) {
+			printf("SWEET TOUCH: GCC branch %#x halted (%#x)\n", branches[i],
+			    touch_rd(st.gcc, branches[i]));
+			return false;
+		}
+	}
+	return true;
+}
+
+/* Called only for a transfer started by this driver, including a stretched TX. */
+static void
+touch_abort(void)
+{
+	touch_wr(st.se, SE_CTRL, 2); /* abort M command, release held bus */
+	bool done = false;
+	for (unsigned i = 0; i < 5000; ++i) {
+		if (touch_rd(st.se, SE_IRQ) & (1u << 5)) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	if (!done || !touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true;
+		printf("SWEET TOUCH: abort failed status=%#x irq=%#x; stopping\n",
+		    touch_rd(st.se, SE_STATUS), touch_rd(st.se, SE_IRQ));
+	}
+	/* Bound drain even if the hardware reports an impossible FIFO count. */
+	for (unsigned i = 0; i < 64 && (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu); ++i) {
+		(void)touch_rd(st.se, SE_RX);
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	if (touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) {
+		st.dead = true;
+		printf("SWEET TOUCH: TX FIFO not empty after abort; stopping\n");
+	}
+}
+
+/* One Linux-style FIFO message. TX is at most 3 bytes; RX at most 90. */
+static int
+touch_msg(uint8_t addr, const uint8_t *tx, unsigned nt, uint8_t *rx,
+    unsigned nr, bool stretch)
+{
+	if (st.dead || nt > 64 || nr > 90 || (nt && nr) || (!nt && !nr)) {
+		return EIO;
+	}
+	if (!touch_wait_clear(st.se, SE_STATUS, 1u)) {
+		st.dead = true; /* no other SE7 owner is supported */
+		return EBUSY;
+	}
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, nr ? SE_RX_LEN : SE_TX_LEN, nr ? nr : nt);
+	touch_wr(st.se, SE_CMD, ((nr ? 2u : 1u) << 27) |
+	    ((uint32_t)addr << 9) | (stretch ? 4u : 0u));
+	unsigned sent = 0, got = 0;
+	int err = ETIMEDOUT;
+	for (unsigned i = 0; i < 20000; ++i) {
+		uint32_t irq = touch_rd(st.se, SE_IRQ);
+		st.irq_status = irq;
+		if (irq & SE_ERRORS) {
+			err = (irq & SE_NACK) ? ENXIO : EIO;
+			/* A completed NACK is normal during address probing. Aborting an
+			 * idle sequencer may never produce ABORT_DONE. Wait for completion
+			 * and leave a clean idle engine available for the other IC. */
+			for (unsigned j = 0; j < 5000 && !(irq & SE_DONE); ++j) {
+				delay(1);
+				irq = touch_rd(st.se, SE_IRQ);
+			}
+			if ((irq & SE_DONE) && !(touch_rd(st.se, SE_STATUS) & 1u) &&
+			    !(touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) &&
+			    !(touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+				touch_wr(st.se, SE_IRQ_CLR, irq);
+				return err;
+			}
+			break;
+		}
+		if (sent < nt && (irq & (1u << 30))) {
+			/* TX FIFO fills LSB-first, four smaller words coalesce */
+			uint32_t word = 0;
+			unsigned todo = nt - sent > 4u ? 4u : nt - sent;
+			for (unsigned j = 0; j < todo; ++j) {
+				word |= (uint32_t)tx[sent + j] << (8u * j);
+			}
+			touch_wr(st.se, SE_TX, word);
+			sent += todo;
+		}
+		uint32_t count = touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu;
+		if (count > ((nr + 7u) >> 2)) {
+			err = EIO;
+			break;
+		}
+		while (count--) {
+			uint32_t word = touch_rd(st.se, SE_RX);
+			for (unsigned j = 0; j < 4 && got < nr; ++j) {
+				rx[got++] = (uint8_t)(word >> (8u * j));
+			}
+		}
+		/* DONE is checked after draining RX, so final short words aren't lost. */
+		if (irq & SE_DONE) {
+			touch_wr(st.se, SE_IRQ_CLR, irq);
+			if (got == nr && sent == nt) {
+				return 0;
+			}
+			err = EIO;
+			break;
+		}
+		/* Preserve DONE/errors if they arrive during this iteration. */
+		touch_wr(st.se, SE_IRQ_CLR, irq & ((1u << 26) | (1u << 27) | (1u << 30)));
+		delay(1);
+	}
+	touch_abort();
+	return err;
+}
+
+static int
+touch_read(uint8_t addr, uint16_t reg, bool wide, uint8_t *buf, unsigned len)
+{
+	uint8_t ptr[2] = {(uint8_t)(reg >> 8), (uint8_t)reg};
+	int err = touch_msg(addr, wide ? ptr : ptr + 1, wide ? 2u : 1u,
+	    NULL, 0, true);
+	if (err) {
+		return err;
+	}
+	/* STOP_STRETCH on the pointer write retains the bus for a repeated START. */
+	return touch_msg(addr, NULL, 0, buf, len, false);
+}
+
+static int
+touch_goodix_ack(void)
+{
+	const uint8_t ack[3] = {0x41, 0x80, 0};
+	return touch_msg(0x5d, ack, sizeof(ack), NULL, 0, false);
+}
+
+static unsigned
+touch_be16(const uint8_t *p)
+{
+	return ((unsigned)p[0] << 8) | p[1];
+}
+
+static bool
+touch_checksum(const uint8_t *buf, unsigned len)
+{
+	unsigned sum = 0;
+	for (unsigned i = 0; i + 2 < len; ++i) {
+		sum += buf[i];
+	}
+	return (sum & 0xffffu) == touch_be16(buf + len - 2);
+}
+
+static void
+touch_report(uint32_t mask, const int *x, const int *y)
+{
+	for (unsigned id = 0; id < TOUCH_MAX; ++id) {
+		uint32_t bit = 1u << id;
+		if (mask & bit) {
+			if (!(st.active & bit) || x[id] != st.x[id] || y[id] != st.y[id]) {
+				sweet_hid_touch((int)id, 1, x[id], y[id]);
+			}
+			st.x[id] = x[id];
+			st.y[id] = y[id];
+		} else if (st.active & bit) {
+			sweet_hid_touch((int)id, 0, st.x[id], st.y[id]);
+		}
+	}
+	st.active = mask;
+}
+
+static int
+touch_goodix(void)
+{
+	uint8_t buf[90];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0;
+	int err = touch_read(0x5d, 0x4180, true, buf, 8);
+	if (err) {
+		return err;
+	}
+	if (!(buf[0] & 0x80u)) {
+		/* Do not acknowledge firmware/config requests that we cannot service. */
+		if (buf[0] & 0x40u) {
+			return ENOTSUP;
+		}
+		return 0; /* no new touch frame: retain current contacts */
+	}
+	if (!touch_checksum(buf, 8)) {
+		return EIO; /* header untrusted: no write to the IC */
+	}
+	unsigned n = buf[2] & 15u;
+	if (n > TOUCH_MAX) {
+		(void)touch_goodix_ack();
+		return EIO;
+	}
+	if (n) {
+		err = touch_read(0x5d, 0x4188, true, buf + 8, n * 8u + 2u);
+		if (err) {
+			return err;
+		}
+		if (!touch_checksum(buf + 8, n * 8u + 2u)) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+	}
+	for (unsigned i = 0; i < n; ++i) {
+		const uint8_t *p = buf + 8u + i * 8u;
+		unsigned id = p[0] >> 4;
+		unsigned px = touch_be16(p + 2), py = touch_be16(p + 4);
+		/* Low nibble 1/3 denotes pen data in the vendor parser. */
+		if ((p[0] & 15u) == 1u || (p[0] & 15u) == 3u || id >= TOUCH_MAX ||
+		    (mask & (1u << id)) || px > 1079 || py > 2399) {
+			(void)touch_goodix_ack();
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+	}
+	err = touch_goodix_ack();
+	if (!err) {
+		touch_report(mask, x, y);
+	}
+	return err;
+}
+
+static int
+touch_focaltech(void)
+{
+	uint8_t buf[63];
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	uint32_t mask = 0, seen = 0;
+	int err = touch_read(0x38, 0, false, buf, sizeof(buf));
+	if (err) {
+		return err;
+	}
+	unsigned n = buf[2] & 15u, active = 0;
+	if ((buf[0] & 0x70u) || n > TOUCH_MAX) {
+		return EIO;
+	}
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		const uint8_t *p = buf + 3u + 6u * i;
+		unsigned id = p[2] >> 4, event = p[0] >> 6;
+		if (id >= TOUCH_MAX) {
+			break; /* vendor's unused-record sentinel */
+		}
+		if (seen & (1u << id)) {
+			return EIO;
+		}
+		seen |= 1u << id;
+		if (event == 1u) {
+			continue; /* UP record */
+		}
+		if (event == 3u) {
+			return EIO;
+		}
+		unsigned px = ((unsigned)(p[0] & 15u) << 8) | p[1];
+		unsigned py = ((unsigned)(p[2] & 15u) << 8) | p[3];
+		if (px > 1079 || py > 2399) {
+			return EIO;
+		}
+		mask |= 1u << id;
+		x[id] = (int)px;
+		y[id] = (int)py;
+		++active;
+	}
+	if (active != n) {
+		return EIO;
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+#define TCM_ADDR          0x20u
+#define TCM_MARKER        0xa5u
+#define TCM_MESSAGE_MAX   256u
+#define TCM_CHUNK         64u
+#define TCM_CMD_NONE      0x00u
+#define TCM_CMD_CONTWRITE 0x01u
+#define TCM_CMD_IDENTIFY  0x02u
+#define TCM_CMD_ENABLE_REPORT 0x05u
+#define TCM_CMD_RUN_APP   0x14u
+#define TCM_CMD_GET_APP_INFO   0x20u
+#define TCM_CMD_GET_TOUCH_REPORT_CONFIG 0x25u
+#define TCM_STATUS_IDLE   0x00u
+#define TCM_STATUS_OK     0x01u
+#define TCM_STATUS_BUSY   0x02u
+#define TCM_STATUS_CONTD  0x03u
+#define TCM_STATUS_ERROR  0x0fu
+#define TCM_STATUS_INVALID 0xffu
+#define TCM_REPORT_IDENTIFY 0x10u
+#define TCM_REPORT_TOUCH    0x11u
+#define TCM_REPORT_STATUS   0x1bu
+#define TCM_MODE_APPLICATION 0x01u
+#define TCM_MODE_BOOTLOADER  0x0bu
+/* TouchComm touch report configuration field codes. */
+#define TCM_TOUCH_END 0x00u
+#define TCM_TOUCH_FOREACH_ACTIVE_OBJECT 0x01u
+#define TCM_TOUCH_FOREACH_OBJECT 0x02u
+#define TCM_TOUCH_FOREACH_END 0x03u
+#define TCM_TOUCH_PAD_TO_NEXT_BYTE 0x04u
+#define TCM_TOUCH_TIMESTAMP 0x05u
+#define TCM_TOUCH_OBJECT_N_INDEX 0x06u
+#define TCM_TOUCH_OBJECT_N_CLASSIFICATION 0x07u
+#define TCM_TOUCH_OBJECT_N_X_POSITION 0x08u
+#define TCM_TOUCH_OBJECT_N_Y_POSITION 0x09u
+#define TCM_TOUCH_OBJECT_N_Z 0x0au
+#define TCM_TOUCH_OBJECT_N_X_WIDTH 0x0bu
+#define TCM_TOUCH_OBJECT_N_Y_WIDTH 0x0cu
+#define TCM_TOUCH_OBJECT_N_TX_POSITION_TIXELS 0x0du
+#define TCM_TOUCH_OBJECT_N_RX_POSITION_TIXELS 0x0eu
+#define TCM_TOUCH_0D_BUTTONS_STATE 0x0fu
+#define TCM_TOUCH_GESTURE_DOUBLE_TAP 0x10u
+#define TCM_TOUCH_FRAME_RATE 0x11u
+#define TCM_TOUCH_POWER_IM 0x12u
+#define TCM_TOUCH_CID_IM 0x13u
+#define TCM_TOUCH_RAIL_IM 0x14u
+#define TCM_TOUCH_CID_VARIANCE_IM 0x15u
+#define TCM_TOUCH_NSM_FREQUENCY 0x16u
+#define TCM_TOUCH_NSM_STATE 0x17u
+#define TCM_TOUCH_NUM_OF_ACTIVE_OBJECTS 0x18u
+#define TCM_TOUCH_NUM_OF_CPU_CYCLES_USED_SINCE_LAST_FRAME 0x19u
+
+static struct {
+	uint8_t config[128];
+	unsigned config_len;
+	uint16_t max_objects;
+} tcm;
+
+static uint32_t
+touch_le16(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8);
+}
+
+static uint32_t
+touch_le32(const uint8_t *p)
+{
+	return (uint32_t)p[0] | ((uint32_t)p[1] << 8) |
+	    ((uint32_t)p[2] << 16) | ((uint32_t)p[3] << 24);
+}
+
+/*
+ * Chunked message read: 4-byte header, then the payload in
+ * CONTINUED_READ pieces, which repeat an 0xa5/0x03 micro-header.
+ */
+static int
+touch_tcm_rdmsg(uint8_t *code, uint8_t *payload, unsigned max, unsigned *plen)
+{
+	uint8_t hdr[4];
+	int err = touch_msg(TCM_ADDR, NULL, 0, hdr, sizeof(hdr), false);
+	if (err) {
+		return err;
+	}
+	if (hdr[0] != TCM_MARKER) {
+		return EIO;
+	}
+	*code = hdr[1];
+	unsigned len = (unsigned)hdr[2] | ((unsigned)hdr[3] << 8);
+	if (len > max) {
+		return EOVERFLOW;
+	}
+	if (len) {
+		unsigned got = 0, total = len + 1; /* payload + padding */
+		while (got < len) {
+			unsigned remaining = total - got;
+			unsigned take = remaining > TCM_CHUNK - 2u ?
+			    TCM_CHUNK - 2u : remaining;
+			if (take == 1u) {
+				/* pure padding tail: Synaptics wants no bus read for it */
+				got += 1;
+				continue;
+			}
+			uint8_t chunk[TCM_CHUNK];
+			err = touch_msg(TCM_ADDR, NULL, 0, chunk, take + 2u, false);
+			if (err) {
+				return err;
+			}
+			if (chunk[0] != TCM_MARKER || chunk[1] != TCM_STATUS_CONTD) {
+				return EIO;
+			}
+			memcpy(payload + got, chunk + 2, take);
+			got += take;
+		}
+	}
+	*plen = len;
+	return 0;
+}
+
+static int
+touch_tcm_write(uint8_t cmd, const uint8_t *payload, unsigned plen)
+{
+	if (plen > TCM_CHUNK - 3u) {
+		return EOVERFLOW;
+	}
+	uint8_t buf[TCM_CHUNK];
+	buf[0] = cmd;
+	buf[1] = (uint8_t)plen;
+	buf[2] = (uint8_t)(plen >> 8);
+	if (plen) {
+		memcpy(buf + 3, payload, plen);
+	}
+	return touch_msg(TCM_ADDR, buf, 3u + plen, NULL, 0, false);
+}
+
+/* Send a command and wait for its STATUS_OK response. */
+static int
+touch_tcm_cmd(uint8_t cmd, const uint8_t *payload, unsigned plen,
+    uint8_t *resp, unsigned max, unsigned *rlen)
+{
+	int err = touch_tcm_write(cmd, payload, plen);
+	if (err) {
+		return err;
+	}
+	for (unsigned i = 0; i < 250; ++i) {
+		uint8_t code;
+		uint8_t msg[TCM_MESSAGE_MAX];
+		unsigned ml = 0;
+		int rc = touch_tcm_rdmsg(&code, msg, sizeof(msg), &ml);
+		if (rc == EOVERFLOW) {
+			/* unexpected oversized async report: skip this poll */
+			touch_wait(5);
+			continue;
+		}
+		if (rc) {
+			touch_wait(5);
+			continue;
+		}
+		if (code == TCM_STATUS_OK) {
+			unsigned n = ml < max ? ml : max;
+			if (n) {
+				memcpy(resp, msg, n);
+			}
+			if (rlen) {
+				*rlen = ml;
+			}
+			return 0;
+		}
+		if (code == TCM_STATUS_ERROR) {
+			return EIO;
+		}
+		touch_wait(5);
+	}
+	return ETIMEDOUT;
+}
+
+static bool
+touch_tcm_identify(bool *app)
+{
+	uint8_t resp[32];
+	unsigned rl = 0;
+	int err = touch_tcm_cmd(TCM_CMD_IDENTIFY, NULL, 0, resp, sizeof(resp), &rl);
+	if (err || rl < 24) {
+		printf("SWEET TOUCH: tcm probe 0x20 err=%d\r\n", err);
+		return false;
+	}
+	char part[17];
+	memcpy(part, resp + 2, 16);
+	part[16] = 0;
+	for (unsigned i = 0; i < 16 && part[i]; ++i) {
+		if ((unsigned char)part[i] < 0x20u) {
+			part[i] = '?';
+		}
+	}
+	printf("SWEET TOUCH: tcm mode=%u part=%s build=%02x:%02x:%02x:%02x packrat=%u\r\n",
+	    resp[1], part, resp[18], resp[19], resp[20], resp[21],
+	    touch_le32(resp + 18));
+	*app = (resp[1] == TCM_MODE_APPLICATION);
+	return true;
+}
+
+static bool
+touch_tcm_appinfo(void)
+{
+	uint8_t resp[64];
+	unsigned rl = 0;
+	for (unsigned i = 0; i < 15; ++i) {
+		rl = 0;
+		int err = touch_tcm_cmd(TCM_CMD_GET_APP_INFO, NULL, 0, resp,
+		    sizeof(resp), &rl);
+		if (!err && rl >= 46) {
+			if (touch_le16(resp + 2) == 1u) { /* APP_STATUS_BOOTING */
+				touch_wait(200);
+				continue;
+			}
+			printf("SWEET TOUCH: tcm panel max-x=%u max-y=%u objects=%u buttons=%u cfg=%u/%u\r\n",
+			    touch_le16(resp + 32), touch_le16(resp + 34),
+			    touch_le16(resp + 36), touch_le16(resp + 38),
+			    touch_le16(resp + 12), touch_le16(resp + 14));
+			tcm.max_objects = (uint16_t)touch_le16(resp + 36);
+			if (tcm.max_objects == 0u || tcm.max_objects > TOUCH_MAX) {
+				tcm.max_objects = TOUCH_MAX;
+			}
+			return true;
+		}
+		touch_wait(100);
+	}
+	printf("SWEET TOUCH: tcm app info failed\r\n");
+	return false;
+}
+
+static bool
+touch_tcm_config(void)
+{
+	uint8_t resp[130];
+	unsigned rl = 0;
+	int err = touch_tcm_cmd(TCM_CMD_GET_TOUCH_REPORT_CONFIG, NULL, 0, resp,
+	    sizeof(resp), &rl);
+	if (err || !rl || rl > sizeof(tcm.config)) {
+		printf("SWEET TOUCH: tcm report config failed err=%d len=%u\r\n",
+		    err, rl);
+		return false;
+	}
+	memcpy(tcm.config, resp, rl);
+	tcm.config_len = rl;
+	printf("SWEET TOUCH: tcm report config %u bytes [%#x,%#x,%#x,%#x,%#x]\r\n",
+	    rl, resp[0], resp[1], resp[2], resp[3], resp[4]);
+	return true;
+}
+
+/* LSB-first bit field from the touch report buffer. */
+static void
+touch_tcm_bits(const uint8_t *rep, unsigned rlen, unsigned off, unsigned bits,
+    unsigned *out)
+{
+	unsigned data = 0, rem = bits, o = off;
+	if (o + bits > rlen * 8u) {
+		*out = 0;
+		return;
+	}
+	while (rem) {
+		unsigned bit = o % 8u, byo = o / 8u;
+		unsigned take = 8u - bit;
+		if (take > rem) {
+			take = rem;
+		}
+		unsigned mask = 0xffu >> (8u - take);
+		data |= ((rep[byo] >> bit) & mask) << (bits - rem);
+		o += take;
+		rem -= take;
+	}
+	*out = data;
+}
+
+/*
+ * Config-driven parser mirroring the Synaptics reference implementation.
+ */
+static int
+touch_tcm_parse(const uint8_t *rep, unsigned rlen)
+{
+	const uint8_t *cfg = tcm.config;
+	unsigned csz = tcm.config_len;
+	int stat[TOUCH_MAX];
+	unsigned ox[TOUCH_MAX], oy[TOUCH_MAX];
+	memset(stat, 0, sizeof(stat));
+	memset(ox, 0, sizeof(ox));
+	memset(oy, 0, sizeof(oy));
+	unsigned idx = 0, off = 0, obj = 0, next = 0, guard = 0;
+	unsigned objects = 0, active_objects = 0;
+	bool active_only = false, have_num = false;
+	for (;;) {
+		if (++guard > 256u) {
+			return EIO;
+		}
+		if (idx >= csz) {
+			return EIO; /* missing TOUCH_END */
+		}
+		uint8_t c = cfg[idx++];
+		if (c == TCM_TOUCH_END) {
+			break;
+		}
+		if (c == TCM_TOUCH_FOREACH_ACTIVE_OBJECT) {
+			obj = 0;
+			next = idx;
+			active_only = true;
+			continue;
+		}
+		if (c == TCM_TOUCH_FOREACH_OBJECT) {
+			obj = 0;
+			next = idx;
+			active_only = false;
+			continue;
+		}
+		if (c == TCM_TOUCH_FOREACH_END) {
+			if (active_only) {
+				if (have_num) {
+					++objects;
+					if (objects < active_objects) {
+						idx = next;
+					}
+				} else if (off < rlen * 8u) {
+					idx = next;
+				}
+			} else {
+				++obj;
+				if (obj < tcm.max_objects) {
+					idx = next;
+				}
+			}
+			continue;
+		}
+		if (c == TCM_TOUCH_PAD_TO_NEXT_BYTE) {
+			off = (off + 7u) & ~7u;
+			continue;
+		}
+		/* value field: [bits] */
+		unsigned bits = cfg[idx++];
+		unsigned data = 0;
+		touch_tcm_bits(rep, rlen, off, bits, &data);
+		off += bits;
+		if (c == TCM_TOUCH_NUM_OF_ACTIVE_OBJECTS) {
+			active_objects = data;
+			have_num = true;
+		} else if (c == TCM_TOUCH_OBJECT_N_INDEX) {
+			obj = data;
+		} else if (c == TCM_TOUCH_OBJECT_N_CLASSIFICATION) {
+			if (obj < TOUCH_MAX && (data == 1u || data == 2u)) {
+				stat[obj] = 1; /* FINGER / GLOVED_FINGER */
+			}
+		} else if (c == TCM_TOUCH_OBJECT_N_X_POSITION) {
+			if (obj < TOUCH_MAX) {
+				ox[obj] = data;
+			}
+		} else if (c == TCM_TOUCH_OBJECT_N_Y_POSITION) {
+			if (obj < TOUCH_MAX) {
+				oy[obj] = data;
+			}
+		}
+		/* every other field is skipped, the offsets already advanced */
+	}
+	uint32_t mask = 0;
+	int x[TOUCH_MAX] = {0}, y[TOUCH_MAX] = {0};
+	for (unsigned i = 0; i < TOUCH_MAX; ++i) {
+		if (stat[i]) {
+			mask |= 1u << i;
+			x[i] = (int)ox[i];
+			y[i] = (int)oy[i];
+		}
+	}
+	touch_report(mask, x, y);
+	return 0;
+}
+
+static int
+touch_tcm_poll(void)
+{
+	uint8_t code;
+	uint8_t msg[TCM_MESSAGE_MAX];
+	unsigned plen = 0;
+	int err = touch_tcm_rdmsg(&code, msg, sizeof(msg), &plen);
+	if (err) {
+		return err;
+	}
+	if (code != TCM_REPORT_TOUCH) {
+		if (code == TCM_STATUS_ERROR) {
+			return EIO;
+		}
+		/* statuses, async identify/status reports, diagnostics: skip */
+		return 0;
+	}
+	if (plen == 0 || !tcm.config_len) {
+		return EIO;
+	}
+	return touch_tcm_parse(msg, plen);
+}
+
+/* Full Synaptics bring-up: identify, reset, app mode, config. */
+static bool
+touch_tcm_start(void)
+{
+	bool app = false;
+	if (!touch_tcm_identify(&app)) {
+		return false;
+	}
+	/* Clean state per the TouchComm reference (reset-on-state = 0). */
+	touch_gpio_out(8, false, 0u, 0u);
+	touch_wait(20);
+	touch_gpio_out(8, true, 3u, 3u); /* ts_active: 8 mA, pull-up */
+	touch_wait(300);
+	bool got = false;
+	for (unsigned i = 0; i < 3 && !got; ++i) {
+		got = touch_tcm_identify(&app);
+	}
+	if (!got) {
+		return false;
+	}
+	if (!app) {
+		printf("SWEET TOUCH: tcm mode %u: running application firmware\r\n",
+		    TCM_MODE_BOOTLOADER);
+		if (touch_tcm_write(TCM_CMD_RUN_APP, NULL, 0)) {
+			return false;
+		}
+		touch_wait(700);
+		if (!touch_tcm_identify(&app) || !app) {
+			return false;
+		}
+	}
+	if (!touch_tcm_appinfo() || !touch_tcm_config()) {
+		return false;
+	}
+	/* TouchComm reports are normally on; re-enable defensively. */
+	(void)touch_tcm_write(TCM_CMD_ENABLE_REPORT, NULL, 0);
+	touch_wait(10);
+	st.kind = TOUCH_TCM;
+	printf("SWEET TOUCH: selected Synaptics TCM, poll=10ms irq-hint=%d\r\n",
+	    st.irq_hint);
+	return true;
+}
+
+static bool
+touch_se_init(void)
+{
+	uint32_t fw = touch_rd(st.se, SE_FW);
+	uint32_t tx = touch_rd(st.se, SE_HW_TX), rx = touch_rd(st.se, SE_HW_RX);
+	printf("SWEET TOUCH: se7 fw=%#x proto=%u status=%#x tx=%#x rx=%#x ios=%#x\n",
+	    fw, (fw >> 8) & 0xffu, touch_rd(st.se, SE_STATUS), tx, rx,
+	    touch_rd(st.se, 0x908));
+	if (((fw >> 8) & 0xffu) != 3u || (touch_rd(st.se, 0x64) & 1u) ||
+	    ((tx >> 24) & 0x3fu) != 32u || ((rx >> 24) & 0x3fu) != 32u ||
+	    ((tx >> 16) & 0x3fu) < 2u || ((rx >> 16) & 0x3fu) < 2u) {
+		printf("SWEET TOUCH: need ABL-loaded I2C firmware and 32-bit FIFOs; probes skipped\n");
+		return false;
+	}
+	if (touch_rd(st.se, SE_STATUS) & 0x1001u) {
+		printf("SWEET TOUCH: SE7 already busy; probes skipped\n");
+		return false;
+	}
+	touch_wr(st.se, 0xe18, 0); /* no GSI events */
+	touch_wr(st.se, 0xe1c, 0); /* mask external IRQ routing; poll local status */
+	touch_wr(st.se, 0x644, 0);
+	touch_wr(st.se, SE_IRQ_CLR, 0xffffffffu);
+	touch_wr(st.se, 0x648, 0xffffffffu);
+	touch_wr(st.se, SE_DMA, 0);
+	touch_wr(st.se, 0x28, touch_rd(st.se, 0x28) | 0x7fu);
+	touch_wr(st.se, 0xe30, touch_rd(st.se, 0xe30) | 0x0fu);
+	touch_wr(st.se, 0x24, 0x7f);
+	touch_wr(st.se, 0x20, 1);
+	touch_wr(st.se, SE_CLK_SEL, 0);
+	touch_wr(st.se, SE_MCLK, (7u << 4) | 1u);
+	touch_wr(st.se, SE_SCL, (10u << 20) | (11u << 10) | 26u); /* 100 kHz */
+	/* Four 8-bit bytes per 32-bit word, LSB byte first (Linux packing). */
+	touch_wr(st.se, 0x254, 0);
+	touch_wr(st.se, 0x260, 0x0004380eu);
+	touch_wr(st.se, 0x264, 0x000c3e0eu);
+	touch_wr(st.se, 0x284, 0x0004380eu);
+	touch_wr(st.se, 0x288, 0x000c3e0eu);
+	touch_wr(st.se, 0x80c, 1);
+	touch_wr(st.se, 0x810, 0);
+	touch_wr(st.se, 0x814, ((rx >> 16) & 0x3fu) - 1u);
+	touch_wr(st.se, SE_IRQ_EN, SE_EVENTS);
+	if ((touch_rd(st.se, SE_TX_COUNT) & 0xfffffffu) ||
+	    (touch_rd(st.se, SE_RX_COUNT) & 0x1ffffffu)) {
+		printf("SWEET TOUCH: inherited FIFO data; probes skipped\n");
+		return false;
+	}
+	return true;
+}
+
+static void
+touch_thread(void *arg, wait_result_t result)
+{
+	unsigned delay_s = 45;
+	(void)arg;
+	(void)result;
+	/*
+	 * Start late (boot-arg sweettouchdelay, seconds): if the bus access
+	 * below hangs the SoC, the persistent log and the GUI got there first.
+	 */
+	(void)PE_parse_boot_argn("sweettouchdelay", &delay_s, sizeof(delay_s));
+	printf("SWEET TOUCH: starting in %u s\n", delay_s);
+	touch_wait(delay_s * 1000u);
+	printf("SWEET TOUCH: mapping GCC/TLMM/SE7\n");
+	st.gcc = ml_io_map(TOUCH_GCC_PA, 0x60000);
+	st.gpio = ml_io_map(TOUCH_NORTH_PA, 0x5b000);
+	st.se = ml_io_map(TOUCH_SE_PA, 0x4000);
+	if (!st.gcc || !st.gpio || !st.se) {
+		printf("SWEET TOUCH: MMIO mapping failed\n");
+		goto out;
+	}
+	if (!touch_clocks() || !touch_se_init()) {
+		goto out;
+	}
+	printf("SWEET TOUCH: TLMM reset=%#x irq=%#x io90=%#x\n",
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(8)), touch_rd(st.gpio, TOUCH_GPIO_IO(9)),
+	    touch_rd(st.gpio, TOUCH_GPIO_IO(90)));
+	touch_gpio(6, 1, 0, 0, false); /* qup11 SDA/SCL, 2 mA, no internal pull */
+	touch_gpio(7, 1, 0, 0, false);
+	touch_gpio(9, 0, 3, 3, false); /* interrupt input, 8 mA, pull-up */
+	touch_wait(10);
+	/* Synaptics TCM first (miatoll IC): TLMM90 is the fingerprint IRQ
+	 * there, so the legacy compatibility writes happen only when the
+	 * Goodix/Focaltech lineage is actually in use. */
+	if (touch_tcm_start()) {
+		goto polling;
+	}
+	/* legacy sweet-soc route (unchanged) */
+	touch_gpio(90, 0, 0, 0, true); /* board digital power enable, high */
+	touch_wait(10);
+	touch_gpio(8, 0, 3, 3, true);  /* release reset; no reset-low pulse */
+	touch_wait(300);
+	uint8_t gid[12] = {0}, fid1 = 0, fid2 = 0;
+	int ge = touch_read(0x5d, 0x4022, true, gid, sizeof(gid));
+	printf("SWEET TOUCH: probe 0x5d err=%d pid=%02x%02x%02x%02x fw=%02x.%02x.%02x.%02x irq=%#x\n",
+	    ge, gid[0], gid[1], gid[2], gid[3], gid[8], gid[9], gid[10], gid[11], st.irq_status);
+	int fe1 = touch_read(0x38, 0xa3, false, &fid1, 1);
+	int fe2 = touch_read(0x38, 0x9f, false, &fid2, 1);
+	printf("SWEET TOUCH: probe 0x38 err=%d/%d chip-id=%02x:%02x irq=%#x\n",
+	    fe1, fe2, fid1, fid2, st.irq_status);
+	bool goodix = !ge && gid[0] == '9' && gid[1] == '8' && gid[2] == '9' && gid[3] == '6';
+	bool fts = !fe1 && !fe2 && fid1 == 0x54 && fid2 == 0x52;
+	if (st.dead || goodix == fts) {
+		printf("SWEET TOUCH: no unique supported IC (goodix=%d fts=%d dead=%d); stopping\n",
+		    goodix, fts, st.dead);
+		goto out;
+	}
+	st.kind = goodix ? TOUCH_GOODIX : TOUCH_FTS;
+	printf("SWEET TOUCH: selected %s, 1080x2400, poll=10ms irq-hint=%d\n",
+	    goodix ? "GT9896 Yellowstone" : "Focaltech 54:52", st.irq_hint);
+	unsigned errors = 0, ticks = 0;
+polling:
+	while (!st.dead) {
+		/* Optional IRQ hint still reads every 100ms, and always while down. */
+		if (!st.irq_hint || st.active || !(touch_rd(st.gpio, TOUCH_GPIO_IO(9)) & 1u) ||
+		    (++ticks % 10u) == 0) {
+			int err = st.kind == TOUCH_GOODIX ? touch_goodix() :
+			    st.kind == TOUCH_TCM ? touch_tcm_poll() : touch_focaltech();
+			if (err) {
+				if ((errors++ % 100u) == 0) {
+					printf("SWEET TOUCH: report err=%d irq=%#x\n", err, st.irq_status);
+				}
+				if (errors == 10) {
+					touch_report(0, st.x, st.y); /* release after persistent bad reads */
+				}
+			} else {
+				errors = 0;
+			}
+		}
+		touch_wait(10);
+	}
+	touch_report(0, st.x, st.y);
+out:
+	(void)thread_terminate(current_thread());
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+void
+sweet_touch_init(void)
+{
+	int enabled = 1;
+	thread_t thread;
+	if (st.started) {
+		return;
+	}
+	st.started = true;
+	(void)PE_parse_boot_argn("sweettouch", &enabled, sizeof(enabled));
+	(void)PE_parse_boot_argn("sweettouchirq", &st.irq_hint, sizeof(st.irq_hint));
+	if (!enabled) {
+		printf("SWEET TOUCH: disabled (sweettouch=0)\n");
+		return;
+	}
+	kern_return_t kr = kernel_thread_start(touch_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET TOUCH: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
