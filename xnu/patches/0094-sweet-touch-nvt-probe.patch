+/* ---- Novatek NT36675 Touch Processing for ios-curtana ---- */
+#define NVT_SWRST_N8 0x3f0feu
+#define NVT_RD_FAST  0x3f310u
+#define NT36675_EVENT_BUF_ADDR 0x22D00
+#define NT36XXX_POINT_DATA_LEN 65
+#define TOUCH_MAX_FINGER_NUM   10
+
+static void
+touch_nvt_write(uint8_t reg, const uint8_t *d, unsigned len)
+{
+       uint8_t tx[8] = {0};
+       if (len > 6u) return;
+       tx[0] = (uint8_t)(reg | 0x80u);
+       for (unsigned i = 0; i < len; ++i) tx[1 + i] = d[i];
+       spi_frame(tx, NULL, 1u + len);
+}
+
+static void
+touch_nvt_read(uint8_t reg, uint8_t *out, unsigned len)
+{
+       uint8_t tx[16] = {0}, rx[16] = {0};
+       if (len > 12u) return;
+       tx[0] = (uint8_t)(reg & 0x7fu);
+       spi_frame(tx, rx, 2u + len);
+       for (unsigned i = 0; i < len; ++i) out[i] = rx[2u + i];
+}
+
+static void
+touch_nvt_page(uint32_t addr)
+{
+       uint8_t b[2] = { (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) };
+       touch_nvt_write(0xff, b, 2);
+}
+
+static void
+touch_nvt_write_addr(uint32_t addr, uint8_t v)
+{
+       touch_nvt_page(addr);
+       touch_nvt_write((uint8_t)(addr & 0x7fu), &v, 1);
+}
+
+static void
+touch_nvt_read_buffer(uint32_t addr, uint8_t *buf, unsigned len)
+{
+       touch_nvt_page(addr);
+       touch_nvt_read((uint8_t)(addr & 0x7fu), buf, len);
+}
+
+static void
+touch_nvt_pins(unsigned order)
+{
+       spi_mosi = touch_spi_order[order][0];
+       spi_miso = touch_spi_order[order][1];
+       spi_clk = touch_spi_order[order][2];
+       spi_cs = touch_spi_order[order][3];
+       spi_out(spi_cs, 1, 6);
+       spi_out(spi_clk, 0, 6);
+       spi_out(spi_mosi, 0, 6);
+       spi_in(spi_miso, 3);
+       delay(2000);
+}
+
+static void
+touch_nvt_process_frame(void)
+{
+       uint8_t point[NT36XXX_POINT_DATA_LEN + 1] = {0};
+       int x[TOUCH_MAX_FINGER_NUM] = {0};
+       int y[TOUCH_MAX_FINGER_NUM] = {0};
+       uint32_t mask = 0;
+
+       touch_nvt_read_buffer(NT36675_EVENT_BUF_ADDR, point, NT36XXX_POINT_DATA_LEN);
+
+       if (point[0] == 0xFD || point[0] == 0xFE || point[0] == 0x77) {
+               return;
+       }
+
+       for (int i = 0; i < TOUCH_MAX_FINGER_NUM; i++) {
+               unsigned int ppos = 6 * i + 1;
+               uint8_t input_id = point[ppos + 0] >> 3;
+
+               if ((input_id == 0) || (input_id > TOUCH_MAX_FINGER_NUM)) continue;
+
+               if (((point[ppos] & 0x07) == 0x01) || ((point[ppos] & 0x07) == 0x02)) {
+                       int px = (point[ppos + 1] << 4) + (point[ppos + 3] >> 4);
+                       int py = (point[ppos + 2] << 4) + (point[ppos + 3] & 0xf);
+
+                       if (px <= 1080 && py <= 2400) {
+                               int slot = input_id - 1;
+                               x[slot] = px;
+                               y[slot] = py;
+                               mask |= (1U << slot);
+                       }
+               }
+       }
+       touch_report(mask, x, y);
+}
+
+static void
+touch_nvt_poll_loop(void)
+{
+       printf("SWEET TOUCH: NVT active touch polling started (NT36675)\n");
+       touch_nvt_write_addr(NVT_SWRST_N8, 0x69);
+       touch_wait(10);
+       touch_nvt_write_addr(NVT_RD_FAST, 0x00);
+       touch_wait(20);
+       while (1) {
+               touch_nvt_process_frame();
+               touch_wait(8);
+       }
+}
+
