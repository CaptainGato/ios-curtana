+/* ---- Novatek NT36xxx on the same bit-banged SPI bus (Redmi Note 9S) ----
+ * Probe only: software reset + chip id. GPIO 8 (reset) is deliberately not
+ * driven: on Novatek panels it may be shared with the display reset. */
+#define NVT_SWRST_N8 0x3f0feu /* DT novatek,swrst-n8-addr */
+#define NVT_RD_FAST  0x3f310u /* DT novatek,spi-rd-fast-addr */
+#define NVT_ID_PAGE  0x1f64eu
+#define NVT_ID_REG   0x4eu
+
+/* vendor CTP_SPI_WRITE: [reg|0x80][data...] */
+static void
+touch_nvt_write(uint8_t reg, const uint8_t *d, unsigned len)
+{
+	uint8_t tx[8] = {0};
+	if (len > 6u) {
+		return;
+	}
+	tx[0] = (uint8_t)(reg | 0x80u);
+	for (unsigned i = 0; i < len; ++i) {
+		tx[1 + i] = d[i];
+	}
+	spi_frame(tx, NULL, 1u + len);
+}
+
+/* vendor CTP_SPI_READ: [reg&0x7f][dummy][data...], data starts at rx[2] */
+static void
+touch_nvt_read(uint8_t reg, uint8_t *out, unsigned len)
+{
+	uint8_t tx[16] = {0}, rx[16] = {0};
+	if (len > 12u) {
+		return;
+	}
+	tx[0] = (uint8_t)(reg & 0x7fu);
+	spi_frame(tx, rx, 2u + len);
+	for (unsigned i = 0; i < len; ++i) {
+		out[i] = rx[2u + i];
+	}
+}
+
+static void
+touch_nvt_page(uint32_t addr)
+{
+	uint8_t b[2] = { (uint8_t)(addr >> 15), (uint8_t)(addr >> 7) };
+	touch_nvt_write(0xff, b, 2);
+}
+
+static void
+touch_nvt_write_addr(uint32_t addr, uint8_t v)
+{
+	touch_nvt_page(addr);
+	touch_nvt_write((uint8_t)(addr & 0x7fu), &v, 1);
+}
+
+/* Same pads as touch_spi_pins(), but GPIO 8/9 are left as ABL set them. */
+static void
+touch_nvt_pins(unsigned order)
+{
+	spi_mosi = touch_spi_order[order][0];
+	spi_miso = touch_spi_order[order][1];
+	spi_clk = touch_spi_order[order][2];
+	spi_cs = touch_spi_order[order][3];
+	spi_out(spi_cs, 1, 6);
+	spi_out(spi_clk, 0, 6);
+	spi_out(spi_mosi, 0, 6);
+	spi_in(spi_miso, 3);
+	delay(2000);
+}
+
+static void
+touch_nvt_print_id(const char *tag, unsigned n)
+{
+	uint8_t id[6] = {0};
+	touch_nvt_page(NVT_ID_PAGE);
+	touch_nvt_read(NVT_ID_REG, id, 6);
+	printf("SWEET TOUCH: NVT %s %u id %02x %02x %02x %02x %02x %02x%s\n",
+		tag, n, id[0], id[1], id[2], id[3], id[4], id[5],
+		(id[3] == 0x75 && id[4] == 0x66 && id[5] == 0x03) ? " = NT36675" : "");
+}
+
+static void
+touch_nvt_probe(void)
+{
+	printf("SWEET TOUCH: NVT probe, software reset only (GPIO 8 untouched)\n");
+	for (unsigned i = 0; i < 5; ++i) {
+		touch_nvt_write_addr(NVT_SWRST_N8, 0x69);
+		touch_wait(5);
+		touch_nvt_write_addr(NVT_RD_FAST, 0x00);
+		touch_nvt_print_id("reset", i);
+		touch_wait(10);
+	}
+	/* repeat every 3 s for 3 min so the line can be caught on the panel */
+	for (unsigned n = 0; n < 60; ++n) {
+		touch_wait(3000);
+		touch_nvt_print_id("poll", n);
+	}
+}
+
