+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+extern kern_return_t thread_terminate(thread_t);
+
+/* Physical blocks (FDT /soc/qcom,kgsl-3d0@5000000 and friends). */
+#define GPU_KGSL_PA     0x05000000u
+#define GPU_KGSL_SIZE   0x00040000u
+#define GPU_GPUCC_PA    0x05090000u
+#define GPU_GPUCC_SIZE  0x00009000u
+#define GPU_GMU_PA      0x0506a000u
+#define GPU_GMU_SIZE    0x00031000u
+#define GPU_SMMU_PA     0x05040000u
+#define GPU_SMMU_SIZE   0x00010000u
+#define GPU_QFPROM_PA   0x00780000u
+#define GPU_QFPROM_SIZE 0x00006300u
+#define GPU_GCC_PA      0x00100000u
+#define GPU_GCC_SIZE    0x00100000u
+
+/* QFPROM: the corrected region holds the fuses the boot ROM copied. */
+#define QFPROM_CORRECTED   0x4000u
+#define QFPROM_SPEED_BIN   0x1e9u
+#define QFPROM_GAMING_BIN  0x1f5u
+
+/* GPUCC, a618 (same block as sdmmagpie / sm6150). */
+#define GPUCC_PLL0_MODE       0x0000u
+#define GPUCC_PLL1_MODE       0x0100u
+#define GPUCC_CXO_AON_CBCR    0x1004u
+#define GPUCC_GX_SW_RESET     0x1008u
+#define GPUCC_GX_GDSCR        0x100cu
+#define GPUCC_GX_GFX3D_RCGR   0x101cu
+#define GPUCC_GX_CXO_CBCR     0x1060u
+#define GPUCC_GX_GMU_CBCR     0x1064u
+#define GPUCC_CX_GDSCR        0x106cu
+#define GPUCC_AHB_CBCR        0x1078u
+#define GPUCC_CX_APB_CBCR     0x1088u
+#define GPUCC_CX_SNOC_DVM_CBCR 0x108cu
+#define GPUCC_CX_GMU_CBCR     0x1098u
+#define GPUCC_CXO_CBCR        0x109cu
+#define GPUCC_CX_GFX3D_CBCR   0x10a4u
+#define GPUCC_CX_GFX3D_SLV_CBCR 0x10a8u
+#define GPUCC_GMU_RCGR        0x1120u
+#define GPUCC_CB_CBCR         0x1170u
+#define GPUCC_HUB_AON_CBCR    0x1178u
+#define GPUCC_HUB_RCGR        0x117cu
+#define GPUCC_HUB_CX_INT_CBCR 0x1204u
+#define GPUCC_CX_HW_CTRL      0x1540u
+#define GPUCC_GX_DOMAIN_MISC  0x158cu
+#define GPUCC_SMMU_VOTE_CBCR  0x5000u
+
+/* GCC: the GPU's clocks outside the GPU's own controller. */
+#define GCC_PLL_VOTE            0x52000u
+#define GCC_PLL_VOTE_MASK       0x00018000u
+#define GCC_GPU_CFG_AHB_CBCR    0x71004u
+#define GCC_GPU_MEMNOC_GFX_CBCR 0x7100cu
+#define GCC_GPU_SNOC_DVM_GFX_CBCR 0x71018u
+#define GCC_DDRSS_GPU_AXI_CBCR  0x71154u
+
+static vm_offset_t gpu_kgsl, gpu_gpucc, gpu_gmu, gpu_smmu, gpu_qfprom, gpu_gcc;
+static void *gpu_sleep_chan;
+
+static uint32_t
+gpu_rd(vm_offset_t base, uint32_t off)
+{
+	if (base == 0) {
+		return 0xffffffffu;
+	}
+	return *(volatile uint32_t *)(base + off);
+}
+
+static void
+gpu_wait(unsigned ms)
+{
+	uint64_t deadline;
+
+	clock_interval_to_deadline(ms, NSEC_PER_MSEC, &deadline);
+	(void)assert_wait_deadline(&gpu_sleep_chan, THREAD_UNINT, deadline);
+	thread_block(THREAD_CONTINUE_NULL);
+}
+
+static void
+gpu_step_map(void)
+{
+	gpu_kgsl = ml_io_map(GPU_KGSL_PA, GPU_KGSL_SIZE);
+	gpu_gpucc = ml_io_map(GPU_GPUCC_PA, GPU_GPUCC_SIZE);
+	gpu_gmu = ml_io_map(GPU_GMU_PA, GPU_GMU_SIZE);
+	gpu_smmu = ml_io_map(GPU_SMMU_PA, GPU_SMMU_SIZE);
+	gpu_qfprom = ml_io_map(GPU_QFPROM_PA, GPU_QFPROM_SIZE);
+	gpu_gcc = ml_io_map(GPU_GCC_PA, GPU_GCC_SIZE);
+	printf("SWEET GPU: step 1: kgsl %#llx gpucc %#llx gmu %#llx smmu %#llx "
+	    "qfprom %#llx gcc %#llx\n",
+	    (unsigned long long)gpu_kgsl, (unsigned long long)gpu_gpucc,
+	    (unsigned long long)gpu_gmu, (unsigned long long)gpu_smmu,
+	    (unsigned long long)gpu_qfprom, (unsigned long long)gpu_gcc);
+}
+
+static void
+gpu_step_fuses(void)
+{
+	/* the fuse offsets are not word aligned: read the word that holds them */
+	uint32_t speed = gpu_rd(gpu_qfprom, QFPROM_CORRECTED + (QFPROM_SPEED_BIN & ~3u));
+	uint32_t gaming = gpu_rd(gpu_qfprom, QFPROM_CORRECTED + (QFPROM_GAMING_BIN & ~3u));
+	uint32_t off;
+
+	printf("SWEET GPU: step 2: qfprom speed_bin(%#x) %#x gaming_bin(%#x) %#x\n",
+	    QFPROM_SPEED_BIN, speed, QFPROM_GAMING_BIN, gaming);
+	/* The fuses are a bitfield; show the words around them once. */
+	for (off = 0x1e0; off <= 0x200; off += 4) {
+		printf("SWEET GPU: qfprom[%#x] %#x\n", QFPROM_CORRECTED + off,
+		    gpu_rd(gpu_qfprom, QFPROM_CORRECTED + off));
+	}
+}
+
+static const struct {
+	uint32_t off;
+	const char *name;
+} gpucc_regs[] = {
+	{ GPUCC_PLL0_MODE, "pll0_mode" },
+	{ GPUCC_PLL1_MODE, "pll1_mode" },
+	{ GPUCC_CXO_AON_CBCR, "cxo_aon_cbcr" },
+	{ GPUCC_GX_SW_RESET, "gx_sw_reset" },
+	{ GPUCC_GX_GDSCR, "gx_gdscr" },
+	{ GPUCC_GX_GFX3D_RCGR, "gx_gfx3d_rcgr" },
+	{ GPUCC_GX_CXO_CBCR, "gx_cxo_cbcr" },
+	{ GPUCC_GX_GMU_CBCR, "gx_gmu_cbcr" },
+	{ GPUCC_CX_GDSCR, "cx_gdscr" },
+	{ GPUCC_AHB_CBCR, "ahb_cbcr" },
+	{ GPUCC_CX_APB_CBCR, "cx_apb_cbcr" },
+	{ GPUCC_CX_SNOC_DVM_CBCR, "cx_snoc_dvm_cbcr" },
+	{ GPUCC_CX_GMU_CBCR, "cx_gmu_cbcr" },
+	{ GPUCC_CXO_CBCR, "cxo_cbcr" },
+	{ GPUCC_CX_GFX3D_CBCR, "cx_gfx3d_cbcr" },
+	{ GPUCC_CX_GFX3D_SLV_CBCR, "cx_gfx3d_slv_cbcr" },
+	{ GPUCC_GMU_RCGR, "gmu_rcgr" },
+	{ GPUCC_CB_CBCR, "cb_cbcr" },
+	{ GPUCC_HUB_AON_CBCR, "hub_aon_cbcr" },
+	{ GPUCC_HUB_RCGR, "hub_rcgr" },
+	{ GPUCC_HUB_CX_INT_CBCR, "hub_cx_int_cbcr" },
+	{ GPUCC_CX_HW_CTRL, "cx_hw_ctrl" },
+	{ GPUCC_GX_DOMAIN_MISC, "gx_domain_misc" },
+	{ GPUCC_SMMU_VOTE_CBCR, "smmu_vote_cbcr" },
+};
+
+static void
+gpu_step_gpucc(void)
+{
+	unsigned i;
+
+	for (i = 0; i < sizeof(gpucc_regs) / sizeof(gpucc_regs[0]); i++) {
+		printf("SWEET GPU: gpucc %-20s [%#06x] %#x\n", gpucc_regs[i].name,
+		    gpucc_regs[i].off, gpu_rd(gpu_gpucc, gpucc_regs[i].off));
+	}
+}
+
+static void
+gpu_step_gcc(void)
+{
+	uint32_t vote = gpu_rd(gpu_gcc, GCC_PLL_VOTE);
+
+	printf("SWEET GPU: step 4: gcc gpu_pll_vote %#x (bits 15/16 %s)\n", vote,
+	    (vote & GCC_PLL_VOTE_MASK) == GCC_PLL_VOTE_MASK ? "on" : "off");
+	printf("SWEET GPU: gcc cfg_ahb_cbcr       %#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_CFG_AHB_CBCR));
+	printf("SWEET GPU: gcc memnoc_gfx_cbcr    %#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_MEMNOC_GFX_CBCR));
+	printf("SWEET GPU: gcc snoc_dvm_gfx_cbcr  %#x\n",
+	    gpu_rd(gpu_gcc, GCC_GPU_SNOC_DVM_GFX_CBCR));
+	printf("SWEET GPU: gcc ddrss_gpu_axi_cbcr %#x\n",
+	    gpu_rd(gpu_gcc, GCC_DDRSS_GPU_AXI_CBCR));
+}
+
+static void
+gpu_wr32(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	*(volatile uint32_t *)(base + off) = value;
+}
+
+static void
+gpu_step_cx_power(void)
+{
+	extern int gpu_rpmh_vreg(const char *res, unsigned mv);
+	int cx_err = gpu_rpmh_vreg("cx", 6);
+	int mx_err = gpu_rpmh_vreg("mx", 6);
+	uint32_t v;
+
+	printf("SWEET GPU: step 5: rpmh cx=%d mx=%d\n", cx_err, mx_err);
+	v = gpu_rd(gpu_gpucc, GPUCC_CX_HW_CTRL);
+
+	printf("SWEET GPU: step 5: cx_hw_ctrl before %#x\n", v);
+	gpu_wr32(gpu_gpucc, GPUCC_CX_HW_CTRL, v | 0x80000000u);
+	gpu_wait(5);
+	printf("SWEET GPU: step 5: cx_hw_ctrl after  %#x\n",
+	    gpu_rd(gpu_gpucc, GPUCC_CX_HW_CTRL));
+}
+
+static void
+gpu_clock_on(const char *name, uint32_t off)
+{
+	uint32_t v = gpu_rd(gpu_gpucc, off);
+
+	gpu_wr32(gpu_gpucc, off, v | 1u);
+	gpu_wait(2);
+	printf("SWEET GPU: clock %-16s [%#06x] %#x -> %#x\n", name, off, v,
+	    gpu_rd(gpu_gpucc, off));
+}
+
+static void
+gpu_step_clocks(void)
+{
+	gpu_clock_on("ahb", GPUCC_AHB_CBCR);
+	gpu_clock_on("cx_gmu", GPUCC_CX_GMU_CBCR);
+	gpu_clock_on("cxo", GPUCC_CXO_CBCR);
+	gpu_clock_on("cxo_aon", GPUCC_CXO_AON_CBCR);
+	gpu_clock_on("smmu_vote", GPUCC_SMMU_VOTE_CBCR);
+}
+
+static void
+gpu_step_cores(void)
+{
+	uint32_t i;
+
+	printf("SWEET GPU: step 7: gmu %#x %#x %#x %#x\n",
+	    gpu_rd(gpu_gmu, 0x0), gpu_rd(gpu_gmu, 0x4),
+	    gpu_rd(gpu_gmu, 0x8), gpu_rd(gpu_gmu, 0xc));
+	for (i = 0; i < 8; i++) {
+		printf("SWEET GPU: smmu idr%u %#x\n", i, gpu_rd(gpu_smmu, 0x020 + 4u * i));
+	}
+}
+
+static void
+gpu_thread(void *arg __unused)
+{
+	uint32_t step = 1, delay_s = 5;
+
+	(void)PE_parse_boot_argn("sweetgpu", &step, sizeof(step));
+	(void)PE_parse_boot_argn("sweetgpudelay", &delay_s, sizeof(delay_s));
+	printf("SWEET GPU: probe up to step %u, starting in %u s\n", step, delay_s);
+	gpu_wait(delay_s * 1000u);
+
+	gpu_step_map();
+	if (step >= 2) {
+		gpu_step_fuses();
+	}
+	if (step >= 3) {
+		gpu_step_gpucc();
+	}
+	if (step >= 4) {
+		gpu_step_gcc();
+	}
+	if (step >= 5) {
+		gpu_step_cx_power();
+	}
+	if (step >= 6) {
+		gpu_step_clocks();
+	}
+	if (step >= 7) {
+		gpu_step_cores();
+	}
+	printf("SWEET GPU: probe done (steps 1..%u)\n", step);
+	thread_terminate(current_thread());
+}
+
+void
+sweet_gpu_boot_probe(void)
+{
+	uint32_t step = 0;
+	thread_t thread;
+	kern_return_t kr;
+
+	(void)PE_parse_boot_argn("sweetgpu", &step, sizeof(step));
+	if (step == 0) {
+		return;		/* the GPU is left alone */
+	}
+	kr = kernel_thread_start(gpu_thread, NULL, &thread);
+	if (kr == KERN_SUCCESS) {
+		thread_deallocate(thread);
+	} else {
+		printf("SWEET GPU: kernel_thread_start failed %d\n", kr);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+
+/* RPMh vote path, embedded here because bsd/dev/sweet_rpmh.c is not in the CI tree */
+#define RH_RSC_PA       0x18220000u
+#define RH_TCS_PA       0x18220d00u
+#define RH_TCS_SIZE     0x3000u
+#define RH_DICT_PA      0x0c3f000cu
+#define RH_DRV          2u
+#define RH_ACTIVE_N     2u       /* DT order: ACTIVE 2, SLEEP 3, WAKE 3 */
+#define RH_NORMAL_N     8u       /* hidden CONTROL TCS is not in this bank */
+#define RH_TCS_STRIDE   0x2a0u
+#define RH_CMD_STRIDE   0x14u
+#define RH_IRQ_EN       0x00u
+#define RH_IRQ_STATUS   0x04u
+#define RH_IRQ_CLEAR    0x08u
+#define RH_WAIT         0x10u
+#define RH_CONTROL      0x14u
+#define RH_STATUS       0x18u
+#define RH_ENABLE       0x1cu
+#define RH_MSGID        0x30u
+#define RH_ADDR         0x34u
+#define RH_DATA         0x38u
+#define RH_CMD_STATUS   0x3cu
+#define RH_AMC_EN       (1u << 16)
+#define RH_TRIGGER      (1u << 24)
+#define RH_ISSUED       (1u << 8)
+#define RH_COMPLETE     (1u << 16)
+#define RH_WRITE_ACK    (8u | (1u << 8) | (1u << 16))
+#define RH_DB_MAGIC     0x0c0330dbu
+#define RH_DB_HEADER    144u
+#define RH_DB_ENTRY     24u
+#define RH_DB_MAX       0x100000u /* policy bound, not a DT size */
+#define RH_VRM          4u
+#define RH_TIMEOUT_US   100000u
+
+static vm_offset_t grh_rsc, grh_tcs, grh_dict, grh_db;
+static uint32_t grh_db_size;
+static unsigned grh_ncpt;
+static unsigned grh_lock;
+static bool grh_poisoned;
+
+static uint32_t
+grh_read(vm_offset_t base, uint32_t off)
+{
+	uint32_t v = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return v;
+}
+
+static void
+grh_write(vm_offset_t base, uint32_t off, uint32_t value)
+{
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(base + off) = value;
+	__asm__ volatile("dsb osh" ::: "memory");
+}
+
+static bool
+grh_sync(uint32_t off, uint32_t value)
+{
+	grh_write(grh_tcs, off, value);
+	for (unsigned i = 0; i < 1000; ++i) {
+		if (grh_read(grh_tcs, off) == value) {
+			return true;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: readback timeout off=%#x want=%#x got=%#x\n",
+	    off, value, grh_read(grh_tcs, off));
+	return false;
+}
+
+/* DB is little endian; avoid packed structs and unaligned Device loads. */
+static uint16_t
+grh_db16(uint32_t off)
+{
+	uint32_t v = grh_read(grh_db, off & ~3u);
+	return (uint16_t)(v >> (8u * (off & 3u)));
+}
+
+static bool
+grh_range(uint32_t off, uint32_t size)
+{
+	return off <= grh_db_size && size <= grh_db_size - off;
+}
+
+static int
+grh_map(void)
+{
+	if (!grh_rsc) {
+		grh_rsc = ml_io_map(RH_RSC_PA, 0x100);
+	}
+	if (!grh_tcs) {
+		grh_tcs = ml_io_map(RH_TCS_PA, RH_TCS_SIZE);
+	}
+	if (!grh_dict) {
+		grh_dict = ml_io_map(RH_DICT_PA, 8);
+	}
+	if (!grh_rsc || !grh_tcs || !grh_dict) {
+		printf("SWEET RPMH: RSC/locator mapping failed\n");
+		return ENOMEM;
+	}
+	uint32_t id = grh_read(grh_rsc, 0);
+	uint32_t solver = grh_read(grh_rsc, 4);
+	uint32_t config = grh_read(grh_rsc, 0x0c);
+	unsigned major = (id >> 16) & 0xffu;
+	unsigned count = (config >> (6u * RH_DRV)) & 0x3fu;
+	grh_ncpt = (config >> 27) & 0x1fu;
+	printf("SWEET RPMH: rsc=%#x tcs=%#x DRV=%u id=%#x solver=%#x config=%#x TCS=%u ncpt=%u\n",
+	    RH_RSC_PA, RH_TCS_PA, RH_DRV, id, solver, config, count, grh_ncpt);
+	/* This client implements the pre-v3 layout only; do not guess v3 offsets. */
+	if ((major != 1 && major != 2) || config == 0xffffffffu ||
+	    solver == 0xffffffffu || count < RH_NORMAL_N ||
+	    count > RH_TCS_SIZE / RH_TCS_STRIDE || grh_ncpt < 3 || grh_ncpt > 16) {
+		printf("SWEET RPMH: unsupported RSC geometry/revision\n");
+		return ENODEV;
+	}
+	if (!grh_db) {
+		uint32_t pa = grh_read(grh_dict, 0);
+		uint32_t size = grh_read(grh_dict, 4);
+		printf("SWEET RPMH: cmd-db locator=%#x pa=%#x size=%#x\n", RH_DICT_PA, pa, size);
+		/* Firmware supplies the reserved RAM address; never scan physical RAM. */
+		if (pa < 0x80000000u || (pa & 3u) || (size & 3u) ||
+		    size < RH_DB_HEADER || size > RH_DB_MAX ||
+		    (uint64_t)pa + size > 0x100000000ULL) {
+			printf("SWEET RPMH: invalid cmd-db locator\n");
+			return EINVAL;
+		}
+		grh_db = ml_io_map(pa, size);
+		if (!grh_db) {
+			return ENOMEM;
+		}
+		grh_db_size = size;
+	}
+	uint32_t db_version = grh_read(grh_db, 0);
+	uint32_t magic = grh_read(grh_db, 4);
+	uint32_t flags = grh_read(grh_db, 140);
+	printf("SWEET RPMH: cmd-db version=%#x magic=%#x checksum=%#x flags=%#x\n",
+	    db_version, magic, grh_read(grh_db, 136), flags);
+	/* Linux only checks magic; version 1 is an intentionally stricter policy. */
+	if (magic != RH_DB_MAGIC || db_version != 1 || (flags & 1u)) {
+		printf("SWEET RPMH: unsupported/standalone cmd-db\n");
+		return EINVAL;
+	}
+	return 0;
+}
+
+static int
+grh_lookup(const char *res, uint32_t *address)
+{
+	uint32_t key[2] = {0, 0};
+	for (unsigned i = 0; i < 8 && res[i]; ++i) {
+		key[i / 4] |= (uint32_t)(uint8_t)res[i] << (8u * (i % 4));
+	}
+	unsigned matches = 0;
+	for (unsigned i = 0; i < 8; ++i) {
+		uint32_t h = 8u + 16u * i;
+		unsigned slave = grh_db16(h);
+		if (!slave) {
+			break;
+		}
+		uint32_t entries = RH_DB_HEADER + grh_db16(h + 2);
+		uint32_t aux = RH_DB_HEADER + grh_db16(h + 4);
+		unsigned count = grh_db16(h + 6);
+		if (slave < 3 || slave > 5 || (entries & 3u) ||
+		    !grh_range(entries, count * RH_DB_ENTRY) || !grh_range(aux, 0)) {
+			printf("SWEET RPMH: malformed cmd-db slave header %u\n", i);
+			return EINVAL;
+		}
+		for (unsigned j = 0; j < count; ++j) {
+			uint32_t e = entries + RH_DB_ENTRY * j;
+			if (grh_read(grh_db, e) != key[0] || grh_read(grh_db, e + 4) != key[1]) {
+				continue;
+			}
+			uint32_t addr = grh_read(grh_db, e + 16);
+			if (slave != RH_VRM || (addr >> 16) != RH_VRM || (addr & 15u) ||
+			    !grh_range(aux + grh_db16(e + 22), grh_db16(e + 20))) {
+				printf("SWEET RPMH: invalid VRM entry for %s\n", res);
+				return EINVAL;
+			}
+			*address = addr;
+			++matches;
+			printf("SWEET RPMH: %s addr=%#x slave=%u aux-version=%#x priority=%#x:%#x\n",
+			    res, addr, slave, grh_db16(h + 8),
+			    grh_read(grh_db, e + 8), grh_read(grh_db, e + 12));
+		}
+	}
+	if (matches != 1) {
+		printf("SWEET RPMH: %s lookup matches=%u; refusing\n", res, matches);
+		return ENODEV;
+	}
+	return 0;
+}
+
+static bool
+grh_free(unsigned t)
+{
+	uint32_t b = t * RH_TCS_STRIDE;
+	/* Idle alone is insufficient: a sleep/wake payload can be armed and idle. */
+	return grh_read(grh_tcs, b + RH_STATUS) != 0 &&
+	    grh_read(grh_tcs, b + RH_STATUS) != 0xffffffffu &&
+	    grh_read(grh_tcs, b + RH_CONTROL) == 0 &&
+	    grh_read(grh_tcs, b + RH_ENABLE) == 0 &&
+	    grh_read(grh_tcs, b + RH_WAIT) == 0 &&
+	    !(grh_read(grh_tcs, RH_IRQ_STATUS) & (1u << t));
+}
+
+static int
+grh_send(uint32_t address, unsigned mv)
+{
+	int chosen = -1;
+	for (unsigned t = 0; t < RH_ACTIVE_N; ++t) {
+		uint32_t b = t * RH_TCS_STRIDE;
+		uint32_t enabled = grh_read(grh_tcs, b + RH_ENABLE);
+		printf("SWEET RPMH: ACTIVE TCS%u idle=%#x control=%#x enable=%#x wait=%#x\n",
+		    t, grh_read(grh_tcs, b + RH_STATUS), grh_read(grh_tcs, b + RH_CONTROL),
+		    enabled, grh_read(grh_tcs, b + RH_WAIT));
+		if (enabled & ~((1u << grh_ncpt) - 1u)) {
+			return EIO;
+		}
+		for (unsigned c = 0; c < grh_ncpt; ++c) {
+			if ((enabled & (1u << c)) &&
+			    (grh_read(grh_tcs, b + RH_ADDR + c * RH_CMD_STRIDE) & ~15u) == address) {
+				printf("SWEET RPMH: conflicting inherited L11C request in TCS%u\n", t);
+				return EBUSY;
+			}
+		}
+		if (chosen < 0 && grh_free(t)) {
+			chosen = (int)t;
+		}
+	}
+	if (chosen < 0) {
+		printf("SWEET RPMH: no empty idle ACTIVE TCS; leaving inherited state intact\n");
+		return EBUSY;
+	}
+	unsigned t = (unsigned)chosen;
+	uint32_t b = t * RH_TCS_STRIDE, bit = 1u << t;
+	uint32_t irq_en = grh_read(grh_tcs, RH_IRQ_EN);
+	if (irq_en == 0xffffffffu || !grh_free(t)) {
+		return EBUSY;
+	}
+	/* Only this TCS's source is masked. Other sources/CPU IRQs remain intact. */
+	if (!grh_sync(RH_IRQ_EN, irq_en & ~bit)) {
+		grh_poisoned = true;
+		return EIO;
+	}
+	if (!grh_free(t)) {
+		/* No payload was touched. Do not acknowledge somebody else's IRQ. */
+		if (!grh_sync(RH_IRQ_EN, (grh_read(grh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+			grh_poisoned = true;
+		}
+		return EBUSY;
+	}
+	/* From here an uncertain write/timeout quarantines our slot for this boot. */
+	grh_poisoned = true;
+	/* HPM (raw 7) is supported by this PMIC5 LDO; enable comes last. */
+	const uint32_t offsets[3] = {0, 8, 4};
+	const uint32_t values[3] = {mv, 7, 1};
+	printf("SWEET RPMH: TCS%u ACTIVE %u mV mode=7 enable=1 irq-enable=%#x\n", t, mv, irq_en);
+	for (unsigned c = 0; c < 3; ++c) {
+		uint32_t cmd = b + c * RH_CMD_STRIDE;
+		if (!grh_sync(cmd + RH_MSGID, RH_WRITE_ACK) ||
+		    !grh_sync(cmd + RH_ADDR, address + offsets[c]) ||
+		    !grh_sync(cmd + RH_DATA, values[c])) {
+			return EIO;
+		}
+	}
+	if (!grh_sync(b + RH_WAIT, 7) || !grh_sync(b + RH_ENABLE, 7) ||
+	    !grh_sync(b + RH_CONTROL, 0) || !grh_sync(b + RH_CONTROL, RH_AMC_EN)) {
+		return EIO;
+	}
+	grh_write(grh_tcs, b + RH_CONTROL, RH_AMC_EN | RH_TRIGGER);
+	uint32_t irq = 0, idle = 0, status[3] = {0, 0, 0};
+	bool done = false, progress = false;
+	for (unsigned us = 0; us < RH_TIMEOUT_US; ++us) {
+		irq = grh_read(grh_tcs, RH_IRQ_STATUS);
+		idle = grh_read(grh_tcs, b + RH_STATUS);
+		bool complete = true;
+		for (unsigned c = 0; c < 3; ++c) {
+			status[c] = grh_read(grh_tcs, b + RH_CMD_STATUS + c * RH_CMD_STRIDE);
+			complete &= status[c] != 0xffffffffu &&
+			    (status[c] & (RH_ISSUED | RH_COMPLETE)) == (RH_ISSUED | RH_COMPLETE);
+		}
+		/* A fresh IRQ or observed execution transition excludes stale CMD_STATUS. */
+		progress |= idle == 0 || !complete;
+		if (idle && idle != 0xffffffffu && irq != 0xffffffffu &&
+		    ((irq & bit) || progress) && complete) {
+			done = true;
+			break;
+		}
+		delay(1);
+	}
+	printf("SWEET RPMH: TCS%u done=%d irq=%#x idle=%#x control=%#x cmd-status=%#x/%#x/%#x\n",
+	    t, done, irq, idle, grh_read(grh_tcs, b + RH_CONTROL), status[0], status[1], status[2]);
+	if (!done) {
+		printf("SWEET RPMH: timeout; TCS quarantined, IRQ remains masked; no reset/retry\n");
+		return ETIMEDOUT;
+	}
+	/* Proven completion: clear trigger before mode, then free only our commands. */
+	if (!grh_sync(b + RH_CONTROL, RH_AMC_EN) || !grh_sync(b + RH_CONTROL, 0) ||
+	    !grh_sync(b + RH_ENABLE, 0) || !grh_sync(b + RH_WAIT, 0)) {
+		return EIO;
+	}
+	grh_write(grh_tcs, RH_IRQ_CLEAR, bit); /* W1C: never clear other TCS bits */
+	if ((grh_read(grh_tcs, RH_IRQ_STATUS) & bit) ||
+	    !grh_sync(RH_IRQ_EN, (grh_read(grh_tcs, RH_IRQ_EN) & ~bit) | (irq_en & bit))) {
+		return EIO;
+	}
+	grh_poisoned = false;
+	printf("SWEET RPMH: L11C ACTIVE vote complete (rail voltage requires hardware verification)\n");
+	return 0;
+}
+
+int
+gpu_rpmh_vreg(const char *res, unsigned mv)
+{
+	/* Board-specific helper: do not apply PMIC5-LDO policy to arbitrary resources. */
+	if (!res || strcmp(res, "ldoc11") || mv < 2950 || mv > 3400) {
+		printf("SWEET RPMH: expected ldoc11 and 2950..3400 mV\n");
+		return EINVAL;
+	}
+	if (__atomic_exchange_n(&grh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	uint32_t address = 0;
+	if (grh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = grh_map();
+	if (!error) {
+		error = grh_lookup(res, &address);
+	}
+	if (!error) {
+		error = grh_send(address, mv);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: enable failed errno=%d\n", error);
+	}
+	__atomic_store_n(&grh_lock, 0, __ATOMIC_RELEASE);
+	return error;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+++ b/bsd/dev/sweet_spmi.c
+/*
+ * Battery-only adaptation of input/sweet_keys.c, observer EXT_READL.
+ * PMIC READ ONLY. The only MMIO store issues a one-byte read command.
+ * No interrupt clear, peripheral enable, charger config, or PMIC writes.
+ * Init is serialized by the single built-in SweetBattery personality.
+ * Battery APIDs are disjoint from the existing keys' 008/4c1 APIDs.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+extern vm_offset_t ml_io_map(vm_offset_t, vm_size_t);
+
+#define SP_CORE_PA 0x0c440000u
+#define SP_OBS_PA  0x0e600000u
+#define SP_CFG_PA  0x0c40a000u
+#define SP_NO_APID 0xffffu
+
+static vm_offset_t sp_core, sp_obs, sp_cfg;
+static IOLock *sp_lock;
+static unsigned sp_count;
+static bool sp_attempted, sp_ready;
+/* A timed-out command may complete late: never reuse that lane this boot. */
+static bool sp_poisoned[512];
+
+static uint32_t
+sp_rd(vm_offset_t base, unsigned off)
+{
+	uint32_t value = *(volatile uint32_t *)(base + off);
+	__asm__ volatile("dmb oshld" ::: "memory");
+	return value;
+}
+
+static uint16_t
+sp_find_apid(unsigned ppid)
+{
+	uint16_t found = SP_NO_APID;
+	for (unsigned i = 0; i < sp_count; ++i) {
+		uint32_t map = sp_rd(sp_core, 0x900u + 4u * i);
+		if (!map || ((map >> 8) & 0xfffu) != ppid) {
+			continue;
+		}
+		unsigned owner = sp_rd(sp_cfg, 0x700u + 4u * i) & 7u;
+		if (found == SP_NO_APID || owner == 0) {
+			found = (uint16_t)i;
+		}
+	}
+	return found;
+}
+
+int
+sweet_spmi_init(void)
+{
+	if (sp_attempted) {
+		return sp_ready ? 0 : -1;
+	}
+	sp_attempted = true;
+	sp_lock = IOLockAlloc();
+	if (!sp_lock) {
+		return -1;
+	}
+	sp_core = ml_io_map(SP_CORE_PA, 0x2000);
+	sp_cfg = ml_io_map(SP_CFG_PA, 0x1000);
+	sp_obs = ml_io_map(SP_OBS_PA, 0x10000); /* EE 0, 512 * 0x80 */
+	if (!sp_core || !sp_cfg || !sp_obs) {
+		printf("SWEET BATTERY: SPMI mapping failed\n");
+		return -1;
+	}
+	uint32_t arb_version = sp_rd(sp_core, 0);
+	sp_count = sp_rd(sp_core, 4) & 0x7ffu;
+	if (arb_version < 0x50000000u || arb_version >= 0x70000000u ||
+	    !sp_count || sp_count > 512) {
+		printf("SWEET BATTERY: unsupported SPMI arb=%#x APIDs=%u\n",
+		    arb_version, sp_count);
+		return -1;
+	}
+	sp_ready = true;
+	printf("SWEET BATTERY: SPMI arb=%#x APIDs=%u, observer reads only\n",
+	    arb_version, sp_count);
+	return 0;
+}
+
+int
+sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out)
+{
+	/* Restrict access to the battery blocks; keys retain their own lanes. */
+	unsigned peripheral = addr >> 8;
+	if (!sp_ready || !out || sid != 0 || addr > 0xffffu ||
+	    (peripheral != 0x10 && peripheral != 0x11 && peripheral != 0x12 &&
+	    peripheral != 0x13 && peripheral != 0x48)) {
+		return -1;
+	}
+	IOLockLock(sp_lock);
+	uint16_t apid = sp_find_apid((sid << 8) | peripheral);
+	if (apid == SP_NO_APID || sp_poisoned[apid]) {
+		IOLockUnlock(sp_lock);
+		return -1;
+	}
+	unsigned off = 0x80u * apid;
+	uint32_t cmd = (1u << 27) | ((addr & 0xffu) << 4);
+	__asm__ volatile("dmb oshst" ::: "memory");
+	*(volatile uint32_t *)(sp_obs + off) = cmd; /* EXT_READL, BC=0 */
+	__asm__ volatile("dsb osh" ::: "memory");
+	for (unsigned i = 0; i < 1000; ++i) {
+		uint32_t status = sp_rd(sp_obs, off + 0x08u);
+		if (status & 1u) {
+			if (status & 0x0eu) {
+				IOLockUnlock(sp_lock);
+				return -1;
+			}
+			*out = (uint8_t)sp_rd(sp_obs, off + 0x18u);
+			IOLockUnlock(sp_lock);
+			return 0;
+		}
+		delay(1);
+	}
+	sp_poisoned[apid] = true;
+	printf("SWEET BATTERY: SPMI timeout sid=%u addr=%#x APID=%u disabled\n",
+	    sid, addr, apid);
+	IOLockUnlock(sp_lock);
+	return -1;
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
+++ b/bsd/dev/sweet_spmi.h
+/* Shared C/C++ interface. Init once, on the SweetBattery start thread. */
+#ifndef SWEET_BATTERY_SPMI_H
+#define SWEET_BATTERY_SPMI_H
+#ifdef __cplusplus
+extern "C" {
+#endif
+int sweet_spmi_init(void);
+/* Thread context only; 0 success, -1 failure; *out unchanged on failure. */
+int sweet_spmi_read(unsigned sid, unsigned addr, uint8_t *out);
+#ifdef __cplusplus
+}
+#endif
 #endif /* ARM64_BOARD_CONFIG_SWEET */
